{
  "name": "geometa-map",
  "version": "1.0.0",
  "private": true,
  "description": "A local, personal GeoGuessr study tool — interactive world map with categorized notes and screenshots per country.",
  "license": "MIT",
  "author": "Dudek Szymon (@Holo911)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Holo911/geometa-map.git"
  },
  "homepage": "https://github.com/Holo911/geometa-map#readme",
  "bugs": {
    "url": "https://github.com/Holo911/geometa-map/issues"
  },
  "keywords": [
    "geoguessr",
    "maplibre",
    "study-tool",
    "notes",
    "offline",
    "local-first",
    "sqlite"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "geodata": "node scripts/prepare-geodata.mjs && node scripts/prepare-facts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.8.1",
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "flag-icons": "^7.5.0",
    "maplibre-gl": "^4.7.1",
    "marked": "^12.0.2",
    "multer": "^2.0.1",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.5.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "mapshaper": "^0.6.102",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "world-countries": "^5.1.0"
  }
}
